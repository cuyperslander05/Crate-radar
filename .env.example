# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
# Public origin of the app. Used for OAuth redirects and as the CORS default.
APP_URL=http://localhost:3000
# Optional comma-separated origin allowlist. Defaults to APP_URL when unset.
# ALLOWED_ORIGINS=https://crate.example.com

# REQUIRED. Encrypts Spotify tokens at rest and signs the OAuth state parameter.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value invalidates stored Spotify tokens and forces users to relink.
APP_SECRET=

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
SQL_HOST=localhost
SQL_PORT=5432
SQL_USER=postgres
SQL_PASSWORD=
SQL_DB_NAME=crate_db
# TLS is on with certificate verification by default. Only relax these for a
# local server with a self-signed certificate.
# SQL_SSL=true
# SQL_SSL_STRICT=true

# ---------------------------------------------------------------------------
# Spotify (https://developer.spotify.com/dashboard)
#
# Spotify does NOT accept "localhost" in a redirect URI - it requires the
# loopback IP literal or https. For local development register exactly:
#   http://127.0.0.1:3000/api/spotify/callback
# That is also the default when APP_URL points at localhost, so you normally
# do not need to set SPOTIFY_REDIRECT_URI. The server prints the exact value
# it will send on startup - copy that into the dashboard.
# ---------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=https://crate.example.com/api/spotify/callback

# ---------------------------------------------------------------------------
# Firebase Admin SDK — backend token verification and privileged calls.
# Project Settings > Service accounts > Generate new private key.
# Keep the private key on one line with literal \n escapes.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Firebase Web SDK — used by the browser (src/lib/firebase.ts).
# Project Settings > General > Your apps > Web app SDK config.
# VITE_FIREBASE_AUTH_DOMAIN must be the real *.firebaseapp.com domain, never
# localhost, and must appear under Authentication > Authorized domains.
# ---------------------------------------------------------------------------
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
